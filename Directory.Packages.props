<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="OrchardCore.Application.Targets" Version="3.0.1" />
    <PackageVersion Include="OrchardCore.Infrastructure" Version="3.0.1" />
    <PackageVersion Include="OrchardCore.OpenId" Version="3.0.1" />
    <PackageVersion Include="OrchardCore.Theme.Targets" Version="3.0.1" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.14" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.14" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.14" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.0.1" />
    <PackageVersion Include="xunit.v3" Version="3.2.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
    <!-- Security updates for the resolved transitive graph; never suppress NuGet audit. -->
    <PackageVersion Include="AngleSharp" Version="1.8.5" />
    <PackageVersion Include="MySqlConnector" Version="2.6.2" />
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="10.0.14" />
    <PackageVersion Include="System.Security.Cryptography.Xml" Version="10.0.14" />
  </ItemGroup>
</Project>
